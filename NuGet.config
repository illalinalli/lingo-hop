<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pinned to nuget.org so restores are reproducible on CI and on the production server.
    Central Package Management (server/Directory.Packages.props) requires a single source
    or explicit source mapping; this file provides the former.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
